# SQL Query used to extract statistics of items sold and their price. 

-- Identifying data names
SELECT *
FROM superstore;

-- #1 items ordered by price
SELECT item_name, price
FROM superstore
ORDER BY price;

-- #2 Average price of each category
SELECT category, AVG(price)
FROM superstore
Group BY category;

-- #3 number of items in kitchen supplies
SELECT COUNT(item_name)
FROM superstore
WHERE category = "Kitchen Supplies";

-- #4 Determine stock value for each item
SELECT item_name, category, SUM(price*stock_quantity) AS inventory_value
FROM superstore
WHERE item_name IN ('Stainless Steel Cookware Set', 'Memory Foam Mattress', 'Smart LED TV', 'Electronics', 'Robot Vacuum Cleaner', 'Wireless Bluetooth Speaker', 'Non-Stick Baking Set', 'Cotton Bedding Set', 'Smart Home Security Camera', 'Air Purifier', 'Premium Coffee Maker', 'Ergonomic Office Chair', 'Wireless Earbuds', 'Slow Cooker', 'Cutlery Set', 'Cozy Throw Blanket')
Group by item_name;
